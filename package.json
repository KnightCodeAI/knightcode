{
  "name": "knightcode",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env run --watch packages/cli/src/bun/cli.ts",
    "start": "bun --env-file=.env run packages/cli/src/bun/cli.ts",
    "check-types": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build:cli": "bun run scripts/build.ts --single",
    "link:cli": "bun run build:cli && cd packages/cli && bun link",
    "test": "bun run --filter '*' test"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "prettier": "^3.8.3",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "@xterm/headless": "5.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
