{
  "name": "knightcode",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env run --watch packages/cli/src/bun/cli.ts",
    "start": "bun --env-file=.env run packages/cli/src/bun/cli.ts",
    "changeset": "bun run scripts/new-changeset.ts",
    "check-types": "tsc --noEmit",
    "check:browser-smoke": "node scripts/check-browser-smoke.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "build:cli": "bun run scripts/build-bundle.ts",
    "build:binary": "bun run scripts/build.ts --single",
    "build:linux": "bun run scripts/build.ts --target=linux-x64",
    "bench": "bun run scripts/bench.ts",
    "screenshots": "bun run scripts/screenshots.ts",
    "eval": "bun run --filter '@knightcode/evals' eval --",
    "link:cli": "bun run build:cli && cd packages/cli && bun link",
    "test": "bun scripts/test-workspaces.ts",
    "test:mcp-conformance": "bun packages/cli/test/mcp-conformance/run.ts",
    "generate:models": "bun run --filter '@knightcode/ai' generate-models",
    "hydrate:model-data": "bun run --filter '@knightcode/ai' hydrate-model-data",
    "check:model-data": "bun run --filter '@knightcode/ai' check:model-data",
    "generate:model-catalog": "bun run --filter '@knightcode/ai' generate-model-catalog",
    "check:model-catalog": "node scripts/publish-model-catalog.mjs --input .artifacts/model-catalog --dry-run",
    "ci:version": "bun run scripts/ci-version.ts",
    "ci:publish": "bun run scripts/ci-publish.ts",
    "ci:publish:dry": "bun run scripts/ci-publish.ts --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.11",
    "@xterm/headless": "5.5.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "prettier": "^3.8.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "overrides": {
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "fast-uri": "3.1.8",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "sharp": "0.35.5",
    "undici": "8.10.2"
  },
  "trustedDependencies": [
    "electron"
  ]
}
