#!/bin/sh

# Get list of staged files before running check
STAGED_FILES=$(git diff --cached --name-only)

bun run scripts/check-lockfile-commit.ts || exit 1

# Run the static checks CI runs (formatting and type checking)
echo "Running formatting and type checking..."
if ! bun run format --log-level warn || ! bun run check-types; then
  echo "Checks failed. Please fix the errors before committing."
  exit 1
fi

# Restage files that were previously staged and may have been modified by formatting
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

echo "All pre-commit checks passed."
