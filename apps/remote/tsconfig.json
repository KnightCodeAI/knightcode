{
	// Worker and test code only. The React app in web/ has its own config:
	// @cloudflare/workers-types declares HTMLRewriter's `Element`, which shadows the DOM
	// `Element` and breaks React's typings. The two global environments cannot share one.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		// For the shadcn CLI only: it resolves "@/" through this file when run from apps/remote.
		// The worker itself never imports "@/".
		"baseUrl": ".",
		"paths": { "@/*": ["./web/src/*"] }
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "../../packages/remote/src/protocol.ts"]
}
