{
	"name": "knightcode-remote",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:worker": "wrangler d1 migrations apply knightcode-remote --local && wrangler dev --routes \"localhost:8787/*\"",
		"deploy": "bun run build && wrangler deploy",
		"typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
		"build": "vite build",
		"test": "vitest --run"
	},
	"dependencies": {
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@cloudflare/workers-types": "5.20260907.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "5.1.1",
		"vite": "7.2.4",
		"wrangler": "4.124.0"
	}
}
