{
	"name": "knightcode-remote",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:worker": "wrangler d1 migrations apply knightcode-remote --local && wrangler dev --routes \"localhost:8787/*\"",
		"deploy": "bun run build && wrangler deploy",
		"typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
		"build": "vite build",
		"test": "vitest --run && vitest --run --config web/vitest.config.ts"
	},
	"dependencies": {
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.37.0",
		"marked": "18.0.5",
		"radix-ui": "1.4.3",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@cloudflare/workers-types": "5.20260907.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "5.1.1",
		"postcss": "8.5.26",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"vite": "7.2.4",
		"wrangler": "4.124.0"
	}
}
