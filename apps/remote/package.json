{
	"name": "knightcode-remote",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
		"build:client": "esbuild client/app.ts client/rooms.ts --bundle --format=esm --outdir=client",
		"test": "vitest --run"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@cloudflare/workers-types": "5.20260907.1",
		"esbuild": "0.28.1",
		"wrangler": "4.124.0"
	}
}
