# Default to LF for text files across the repo
* text=auto eol=lf

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Served for `irm | iex`; its here-strings become launcher files, and the
# Git Bash launcher must not pick up CRs.
apps/web/public/install.ps1 text eol=lf

# Shell scripts should keep LF
*.sh text eol=lf

# Archived patch artifacts preserve whitespace exactly
packages/agent/docs/**/*.diff -whitespace

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
