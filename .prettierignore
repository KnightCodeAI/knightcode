# Prettier also honours .gitignore, so node_modules/, dist/, .artifacts/ and
# friends are already excluded. This file covers what is tracked but must not be
# reformatted.

# Generated by packages/ai/scripts/generate-models.ts and generate-image-models.ts.
# Formatting them makes the next regeneration produce a spurious diff.
packages/ai/src/*.generated.ts
packages/ai/src/providers/*.models.ts
packages/ai/src/providers/images/*.models.ts

# Test fixtures are inputs, not source: several are deliberately malformed
# (invalid YAML frontmatter, missing fields) and formatting them breaks the
# tests that assert those failures.
packages/*/test/fixtures/

# Generated changelogs (Changesets owns these).
packages/*/CHANGELOG.md

# apps/web has its own Prettier config, ignore file and `format` script, and
# needs prettier-plugin-tailwindcss, which is not installed at the root.
apps/

# Plugin-managed, not repo source.
.superpowers/
