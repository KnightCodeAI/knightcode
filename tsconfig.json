{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@knightcode/telemetry": ["./packages/telemetry/src/index.ts"],
      "@knightcode/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
      "@knightcode/ai": ["./packages/ai/src/index.ts"],
      "@knightcode/ai/oauth": ["./packages/ai/src/oauth.ts"],
      "@knightcode/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
      "@knightcode/codemode": ["./packages/codemode/src/index.ts"],
      "@knightcode/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
      "@knightcode/codemode/source": ["./packages/codemode/src/source.ts"],
      "@knightcode/codemode/portable": ["./packages/codemode/src/portable.ts"],
      "@knightcode/codemode/cloudflare": ["./packages/codemode/src/cloudflare.ts"],
      "@knightcode/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
      "@knightcode/mcp": ["./packages/mcp/src/index.ts"],
      "@knightcode/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
      "@knightcode/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
      "@knightcode/durable": ["./packages/durable/src/index.ts"],
      "@knightcode/env": ["./packages/env/src/index.ts"],
      "@knightcode/durable/testing": ["./packages/durable/src/testing/index.ts"],
      "@knightcode/durable/*": ["./packages/durable/src/*.ts", "./packages/durable/src/*/index.ts", "./packages/durable/src/*"],
      "@knightcode/agent": ["./packages/agent/src/index.ts"],
      "@knightcodeai/cli": ["./packages/cli/src/index.ts"],
      "@knightcodeai/cli/hooks": ["./packages/cli/src/core/hooks/index.ts"],
      "@knightcodeai/cli/*": ["./packages/cli/src/*"],
      "@knightcode/chord": ["./packages/chord/src/index.ts"],
      "@knightcode/chord/context": ["./packages/chord/src/context/index.ts"],
      "@knightcode/chord/delta": ["./packages/chord/src/delta/index.ts"],
      "@knightcode/chord/*": ["./packages/chord/src/*.ts", "./packages/chord/src/*"],
      "@knightcode/protocol": ["./packages/protocol/src/index.ts"],
      "@knightcode/protocol/*": ["./packages/protocol/src/*"],
      "@knightcode/remote": ["./packages/remote/src/index.ts"],
      "@knightcode/remote/*": ["./packages/remote/src/*"],
      "@knightcode/tools": ["./packages/tools/src/index.ts"],
      "@knightcode/tools/*": ["./packages/tools/src/*"],
      "@knightcode/client": ["./packages/client/src/index.ts"],
      "@knightcode/client/control": ["./packages/client/src/control.ts"],
      "@knightcode/client/unix": ["./packages/client/src/unix.ts"],
      "@knightcode/client/*": ["./packages/client/src/*"],
      "@knightcode/server": ["./packages/server/src/index.ts"],
      "@knightcode/server/unix": ["./packages/server/src/transports/unix/index.ts"],
      "@knightcode/server/*": ["./packages/server/src/*"],
      "@knightcode/tui": ["./packages/tui/src/index.ts"],
      "@knightcode/tui/*": ["./packages/tui/src/*"],
      "typebox": ["./node_modules/typebox"]
    }
  },
  "include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/evals/evals/**/*"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
