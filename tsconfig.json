      "@knightcode/chord/web": ["./packages/chord/src/web/index.ts"],
      "@knightcode/chord/surfaces": ["./packages/chord/src/node/surfaces/index.ts"],
      "@knightcode/chord/react": ["./packages/chord/src/react/index.ts"],
      "@knightcode/chord/tui": ["./packages/chord/src/tui/index.ts"],
