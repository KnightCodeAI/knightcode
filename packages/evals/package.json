{
	"name": "@knightcode/evals",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"eval": "bun run eval:host && bun run eval:docs --",
		"eval:host": "vitest run --config vitest.evals.config.ts --project host",
		"eval:docs": "node --experimental-strip-types src/cli.ts",
		"test": "vitest run --config vitest.test.config.ts"
	},
	"devDependencies": {
		"@knightcode/ai": "workspace:*",
		"@knightcodeai/cli": "workspace:*",
		"@vitest-evals/core": "0.15.0",
		"vitest-evals": "0.15.0"
	}
}
