{
  "name": "@knightcode/chord",
  "version": "0.1.0",
  "private": true,
  "description": "Object runtime for apps across processes: contracts, documents, a store, links, plugins with hot reload, HTTP, workers, web and terminal clients",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context/index.ts",
    "./output": "./src/output.ts",
    "./delta": "./src/delta/index.ts",
    "./json": "./src/json.ts",
    "./watch": "./src/watch.ts",
    "./telemetry-sqlite": "./src/telemetry-sqlite/index.ts",
    "./telemetry-sqlite/node": "./src/telemetry-sqlite/node.ts",
    "./sqlite": "./src/sqlite/index.ts",
    "./sqlite/node": "./src/sqlite/node.ts",
    "./sqlite/cloudflare": "./src/sqlite/cloudflare.ts",
    "./http": "./src/node/http/index.ts",
    "./workers": "./src/node/workers/index.ts",
    "./workers/child": "./src/node/workers/child.ts",
    "./plugins": "./src/node/plugins/index.ts",
    "./plugins/runtime": "./src/node/plugins/runtime.ts",
    "./app": "./src/node/app/index.ts",
    "./app/files": "./src/node/app/files-entry.ts",
    "./web": "./src/web/index.ts",
    "./surfaces": "./src/node/surfaces/index.ts",
    "./react": "./src/react/index.ts",
    "./tui": "./src/tui/index.ts",
    "./tui/launcher": "./src/node/tui/index.ts",
    "./sync": "./src/sync/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@knightcode/telemetry": "workspace:*",
    "@knightcode/schema": "workspace:*"
  },
  "peerDependencies": {
    "esbuild": "0.28.2",
    "react": "19.2.4",
    "ws": "8.21.3"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "8.21.3"
  },
  "scripts": {
    "test": "vitest --run"
  }
}
