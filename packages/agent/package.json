{
  "name": "@knightcode/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./harness/context": "./src/harness/context.ts",
    "./harness/env/nodejs": "./src/harness/env/nodejs.ts",
    "./harness/runtime/reducer": "./src/harness/runtime/reducer.ts",
    "./harness/session": "./src/harness/session/index.ts",
    "./harness/session/testing": "./src/harness/session/testing/index.ts",
    "./session/testing": "./src/harness/session/testing/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@knightcode/chord": "workspace:*",
    "@knightcode/ai": "workspace:*",
    "@knightcode/telemetry": "workspace:*",
    "diff": "8.0.4",
    "ignore": "7.0.5",
    "typebox": "1.3.7",
    "yaml": "2.9.0"
  },
  "scripts": {
    "bench:session:timing": "vitest bench --run --config vitest.benchmark.config.ts",
    "bench:session:memory": "tsx --tsconfig benchmark/tsconfig.json benchmark/session/loaded-footprint.ts",
    "bench:session:allocations": "tsx --tsconfig benchmark/tsconfig.json benchmark/session/allocation-profile.ts",
    "test": "vitest --run",
    "test:session:conformance": "vitest --run --config vitest.harness.config.ts test/harness/memory-conformance.test.ts"
  }
}
