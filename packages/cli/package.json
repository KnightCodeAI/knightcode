{
  "name": "@knightcodeai/cli",
  "version": "0.5.4",
  "description": "KnightCode — a local, BYOK terminal coding agent powered by OpenRouter.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightCodeAI/knightcode.git"
  },
  "homepage": "https://knightcode.raghavseth.in",
  "license": "MIT",
  "knightcodeConfig": {
    "configDir": ".knightcode"
  },
  "bin": {
    "knightcode": "./bin/knightcode"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rpc-entry": "./src/rpc-entry.ts",
    "./client": "./src/client/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "files": [
    "bin/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/bun/cli.ts",
    "start": "bun --env-file=../../.env run src/bun/cli.ts",
    "check-types": "tsc --noEmit -p ../../tsconfig.json",
    "test": "vitest --run"
  },
  "optionalDependencies": {
    "@knightcodeai/cli-linux-x64": "0.5.4",
    "@knightcodeai/cli-linux-arm64": "0.5.4",
    "@knightcodeai/cli-darwin-x64": "0.5.4",
    "@knightcodeai/cli-darwin-arm64": "0.5.4",
    "@knightcodeai/cli-win32-x64": "0.5.4",
    "@mariozechner/clipboard": "0.3.9"
  },
  "devDependencies": {
    "@knightcode/agent": "workspace:*",
    "@knightcode/ai": "workspace:*",
    "@knightcode/client": "workspace:*",
    "@knightcode/protocol": "workspace:*",
    "@knightcode/server": "workspace:*",
    "@knightcode/session-backend-sqlite": "workspace:*",
    "@knightcode/tui": "workspace:*",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@types/cross-spawn": "6.0.6",
    "@types/hosted-git-info": "3.0.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "7.7.1",
    "chalk": "5.6.2",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "grok-mermaid": "0.2.2",
    "highlight.js": "10.7.3",
    "hosted-git-info": "9.0.3",
    "ignore": "7.0.5",
    "jiti": "2.7.0",
    "minimatch": "10.2.5",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.0",
    "typebox": "1.3.7",
    "undici": "8.9.0",
    "yaml": "2.9.0"
  }
}
