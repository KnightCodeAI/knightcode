{
  "name": "@knightcodeai/cli",
  "version": "0.20.0",
  "description": "KnightCode — a local, BYOK terminal coding agent powered by OpenRouter.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightCodeAI/knightcode.git"
  },
  "homepage": "https://knightcode.dev",
  "license": "MIT",
  "knightcodeConfig": {
    "configDir": ".knightcode"
  },
  "bin": {
    "knightcode": "./dist/bundle/cli.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rpc-entry": "./src/rpc-entry.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/bun/cli.ts",
    "start": "bun --env-file=../../.env run src/bun/cli.ts",
    "check-types": "tsc --noEmit -p ../../tsconfig.json",
    "test": "vitest --run",
    "generate:schemas": "bun scripts/generate-schemas.ts",
    "generate:references": "bun scripts/generate-references.ts"
  },
  "dependencies": {
    "@silvia-odwyer/photon-node": "0.3.4",
    "jiti": "2.7.0",
    "quickjs-wasi": "3.6.2"
  },
  "devDependencies": {
    "@knightcode/agent": "workspace:*",
    "@knightcode/ai": "workspace:*",
    "@knightcode/app-server-protocol": "workspace:*",
    "@knightcode/codemode": "workspace:*",
    "@knightcode/mcp": "workspace:*",
    "@knightcode/remote": "workspace:*",
    "@knightcode/tools": "workspace:*",
    "@knightcode/tui": "workspace:*",
    "@types/cross-spawn": "6.0.6",
    "@types/hosted-git-info": "3.0.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "7.7.1",
    "brace-expansion": "5.0.12",
    "chalk": "6.0.0",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "grok-mermaid": "0.2.3",
    "highlight.js": "10.7.3",
    "hosted-git-info": "9.0.3",
    "ignore": "7.0.8",
    "marked": "18.0.11",
    "minimatch": "10.2.6",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.5",
    "typebox": "1.3.27",
    "undici": "8.10.2",
    "yaml": "2.9.0"
  }
}
