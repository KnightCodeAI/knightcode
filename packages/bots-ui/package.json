{
	"name": "@knightcode/bots-ui",
	"version": "0.1.0",
	"private": true,
	"description": "The KnightCode Bots interface, shared by the web app and the desktop app",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./styles.css": "./src/styles.css",
		"./components.css": "./src/components.css",
		"./templates": "./src/bot/templates-data.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "vitest --run",
		"typecheck": "tsc --noEmit",
		"tokens": "bun src/tokens/css.ts"
	},
	"dependencies": {
		"@fontsource-variable/libre-franklin": "5.3.0",
		"@knightcode/bots-protocol": "workspace:*",
		"@knightcode/chord": "workspace:*",
		"lucide-react": "1.37.0",
		"marked": "18.0.11",
		"mermaid": "12.2.0",
		"radix-ui": "1.4.3"
	},
	"peerDependencies": {
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.4",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"vitest": "4.1.12"
	}
}
