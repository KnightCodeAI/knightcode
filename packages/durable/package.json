{
  "name": "@knightcode/durable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env/index.ts",
    "./env/node": "./src/env/node.ts",
    "./tools": "./src/tools/index.ts",
    "./images": "./src/images/index.ts",
    "./images/node": "./src/images/node.ts",
    "./images/cloudflare": "./src/images/cloudflare.ts",
    "./storage/memory": "./src/storage/memory.ts",
    "./storage/jsonl": "./src/storage/jsonl/index.ts",
    "./storage/jsonl/node": "./src/storage/jsonl/node.ts",
    "./storage/sqlite": "./src/storage/sqlite/index.ts",
    "./storage/sqlite/node": "./src/storage/sqlite/node.ts",
    "./storage/sqlite/bun": "./src/storage/sqlite/bun.ts",
    "./storage/sqlite/cloudflare": "./src/storage/sqlite/cloudflare.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@knightcode/ai": "workspace:*",
    "@knightcode/chord": "workspace:*",
    "@silvia-odwyer/photon": "0.3.3",
    "diff": "8.0.4",
    "typebox": "1.3.27"
  },
  "scripts": {
    "test": "vitest --run",
    "bench:storage": "vitest bench --config vitest.benchmark.config.ts",
    "bench:storage:memory": "node --conditions=source --experimental-strip-types test/storage-memory.ts",
    "bench:tool-output": "node --conditions=source --experimental-strip-types --expose-gc test/tool-output-bench.ts",
    "bench:nested-tools": "node --conditions=source --experimental-strip-types --expose-gc test/nested-tools-bench.ts",
    "bench:nested-images": "node --conditions=source --experimental-strip-types --expose-gc test/nested-images-bench.ts",
    "bench:scheduler-fanout": "node --conditions=source --experimental-strip-types test/scheduler-fanout-bench.ts"
  }
}
